---
/**
 * Layout for every markdown and MDX article (blog posts and pens).
 *
 * Keeps the existing frontmatter: title, description, date, tags, draft, dutch.
 * Adds the left rail (headings + reading progress), footnotes in the margin,
 * and links to the previous and next post.
 */
import { readFileSync } from 'node:fs';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import TocRail from '../components/TocRail.astro';
import {
  formatDate,
  getPosts,
  parseDate,
  postUrl,
  readingTime,
  tagList,
  type PostFrontmatter,
} from '../lib/posts';

interface Props {
  frontmatter: PostFrontmatter;
  headings?: MarkdownHeading[];
  rawContent?: () => string;
  url?: string;
  file?: string;
}

const { frontmatter, headings = [], rawContent, url, file } = Astro.props;
const { title, description, draft, dutch } = frontmatter;
const date = parseDate(frontmatter.date);
const tags = tagList(frontmatter.tags);

// Markdown hands us its source; for MDX we read the file, minus frontmatter and imports.
const source =
  rawContent?.() ??
  (file ? readFileSync(file, 'utf8').replace(/^---[\s\S]*?---/, '').replace(/^import .*$/gm, '') : '');
const minutes = readingTime(source);

// Headings for the rail: h2 and h3, minus the hidden "Footnotes" heading.
const toc = headings
  .filter((h) => h.depth >= 2 && h.depth <= 3 && h.slug !== 'footnote-label')
  .map((h) => ({ id: h.slug, text: h.text, depth: h.depth }));

// Previous (older) and next (newer) post. Only for published blog posts.
const posts = await getPosts();
const index = posts.findIndex((post) => post.url === url);
const newer = index > 0 ? posts[index - 1] : undefined;
const older = index >= 0 ? posts[index + 1] : undefined;
---

<BaseLayout title={title} description={description} toc={toc} progress type="article">
  <article class="page-grid" id="top" data-post lang={dutch ? 'nl' : undefined}>
    <header class="post-header wide">
      {
        tags.length > 0 && (
          <ul class="post-tags" aria-label="Tags">
            {tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )
      }
      <h1 class="post-title">{title}</h1>
      <p class="post-meta">
        {date && <time datetime={date.toISOString()}>{formatDate(date)}</time>}
        <span>{minutes} min read</span>
      </p>
      {
        dutch && (
          <aside class="information" lang="en">
            <p>This article is written in Dutch. Use your browser's translation function if you need it.</p>
          </aside>
        )
      }
      {
        draft && (
          <aside lang="en">
            <p>This article is a draft.</p>
          </aside>
        )
      }
    </header>

    <div class="prose" data-post-body>
      <slot />
    </div>

    <div class="sidenotes" data-sidenotes></div>

    {
      (older || newer) && (
        <footer class="post-footer" lang="en">
          <nav class="post-nav" aria-label="More articles">
            {older && (
              <a class="post-nav__prev" href={postUrl(older)}>
                <span class="post-nav__label">Previous</span>
                <span class="post-nav__title">{older.frontmatter.title}</span>
              </a>
            )}
            {newer && (
              <a class="post-nav__next" href={postUrl(newer)}>
                <span class="post-nav__label">Next</span>
                <span class="post-nav__title">{newer.frontmatter.title}</span>
              </a>
            )}
          </nav>
        </footer>
      )
    }
  </article>

  <TocRail items={toc} title={title} />

  <script>
    import { initSidenotes } from '../scripts/sidenotes';
    document.querySelectorAll<HTMLElement>('[data-post]').forEach(initSidenotes);
  </script>
</BaseLayout>
