---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostEntry from '../components/PostEntry.astro';
import { getPosts } from '../lib/posts';

const recentPosts = (await getPosts()).slice(0, 5);
---

<BaseLayout>
  <div class="page-grid" id="top">
    <header class="intro wide">
      <!-- <h1 class="intro__title">Luc Tiemessen</h1> -->
      <p class="intro__text">Hi there, I'm a designer from Utrecht, <a href="http://www.ing.nl">working</a> in Amsterdam on web and native mobile apps that are easy to understand and a joy to use. I like to spend time thinking and <a href="/blog/">writing</a> about technology, design and <a href="/pens/">fountain pens</a>.</p>
      <p class="intro__text"><a href="/about/">Read more about me</a>.</p>
    </header>

    <section class="archive wide" aria-labelledby="recent-writing">
      <h2 class="archive__year" id="recent-writing">Recent writing</h2>
      <ol class="archive__list">
        {recentPosts.map((post) => <PostEntry post={post} />)}
      </ol>
      <p class="archive__more"><a href="/blog/">View all articles</a></p>
    </section>
  </div>
</BaseLayout>
