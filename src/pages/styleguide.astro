---
/**
 * Styleguide: all style elements of the site on one page.
 *
 * Based on the original styleguide, supplemented with the components
 * of this template. The explanation of each example is in the margin
 * (.spec__note), just like a note.
 *
 * The examples of the overview and the navigation use real posts and
 * the same components as the rest of the site (PostEntry, .post-nav).
 *
 * Note: keep a paragraph on one line in this template. Astro can remove
 * whitespace with a line break between text and an element.
 */
import { Image } from 'astro:assets';
import { Code } from 'astro:components';
import BaseLayout from '../layouts/BaseLayout.astro';
import TocRail from '../components/TocRail.astro';
import PostEntry from '../components/PostEntry.astro';
import { SITE } from '../site.config';
import { getPosts, formatDate, parseDate, readingTime, postUrl, summary } from '../lib/posts';
import brug from '../assets/brug.jpg';
import '../styles/styleguide.css';

const toc = [
  { id: 'colour', text: 'Colour', depth: 2 },
  { id: 'typefaces', text: 'Typefaces', depth: 2 },
  { id: 'headings', text: 'Headings', depth: 2 },
  { id: 'paragraphs', text: 'Paragraphs', depth: 2 },
  { id: 'text-formatting', text: 'Text formatting', depth: 2 },
  { id: 'boxes', text: 'Boxes and quotes', depth: 2 },
  { id: 'lists', text: 'Lists', depth: 2 },
  { id: 'code', text: 'Code', depth: 2 },
  { id: 'images', text: 'Images', depth: 2 },
  { id: 'tables', text: 'Tables', depth: 2 },
  { id: 'margin-line', text: 'Margin line, notes and menu', depth: 2 },
  { id: 'components', text: 'Components', depth: 2 },
];

const swatches = [
  { name: 'Paper', token: '--paper', light: '#f7f5f1', dark: '#1c1d1b', use: 'Background' },
  { name: 'Paper, raised', token: '--paper-raised', light: '#fdfcfa', dark: '#232421', use: 'Menu, keys, windows' },
  { name: 'Ink', token: '--ink', light: '#1d1c1a', dark: '#e9e6e0', use: 'Text and headings' },
  { name: 'Ink 2', token: '--ink-2', light: '#4a4741', dark: '#bfbab1', use: 'Intro, quotes, boxes' },
  { name: 'Ink 3', token: '--ink-3', light: '#736e65', dark: '#969186', use: 'Metadata, notes, captions' },
  { name: 'Line', token: '--rule', light: '#e3dfd6', dark: '#33342f', use: 'Dividers' },
  { name: 'Line, strong', token: '--rule-strong', light: '#cbc5b9', dark: '#4a4b45', use: 'Margin line, table header' },
  { name: 'Accent', token: '--accent', light: '#2f6f4f', dark: '#8bc6a1', use: 'Links, note numbers' },
  { name: 'Accent, light', token: '--accent-tint', light: '#e1ebe3', dark: '#26352b', use: 'Highlights, information box' },
  { name: 'Code', token: '--code-bg', light: '#eeebe4', dark: '#272824', use: 'Background of code' },
];

const pens = [
  ['2025', 'Studio Arctic Silver', 'Matt silver, metallic', 'Steel', 'Rubber', 'Satin metallic', 'Special edition'],
  ['2024', 'Studio Racing Green', 'Deep British green', 'Gold (14k)', 'Steel', 'High-gloss metallic', 'Special edition'],
  ['2023', 'Studio Lilac', 'Soft lavender, metallic', 'Steel', 'Rubber', 'Satin anodised', 'Special edition'],
  ['2022', 'Studio Black Forest', 'Dark green, almost black', 'Gold (14k)', 'Steel', 'High-gloss lacquer', 'Regular colour (first a special edition)'],
  ['2021', 'Studio Glacier', 'Cool ice blue', 'Steel', 'Rubber', 'Satin anodised', 'Special edition'],
  ['2020', 'Studio Rose', 'Warm rose gold', 'Steel', 'Steel', 'Matt metallic', 'Special edition'],
  ['2019', 'Studio Aquamarine', 'Deep turquoise', 'Steel', 'Steel', 'Anodised', 'Special edition'],
  ['2018', 'Studio Olive', 'Matt olive green', 'Steel', 'Rubber', 'Matt lacquer', 'Special edition'],
  ['2017', 'Studio Imperial Blue', 'Deep metallic blue', 'Steel', 'Rubber', 'High-gloss lacquer', 'Later part of the regular range'],
  ['2016', 'Studio LX All Black', 'Matt black', 'Steel (black coated)', 'Rubber', 'Matt lacquer', 'Special monochrome edition'],
];
const penColumns = ['Name', 'Colour', 'Nib', 'Grip', 'Finish', 'Note'];

const jsSample = `function showError(error) {
  if(error.code==0) {
    alert('An unknown error occurred.');
  } else if(error.code==1) {
    alert('No permission to locate your position.');
  } else if(error.code==2) {
    alert('The location could not be retrieved.');
  } else {
    alert('There was a timeout.');
  }
}`;

const cssSample = `.ninja {
    visibility: hidden;
    animation-duration: 0.000001s;
}`;

const codeThemes = { light: 'github-light', dark: 'github-dark' } as const;

// Real posts for the examples of the overview and the navigation.
const posts = await getPosts();
const [featured, ...rest] = posts;
const featuredDate = featured && parseDate(featured.frontmatter.date);
const demoEntries = rest.slice(0, 2);
const demoYear = demoEntries[0] && parseDate(demoEntries[0].frontmatter.date)?.getFullYear();
---

<BaseLayout title="Styleguide" description={`All style elements of ${SITE.title} on one page.`} toc={toc} progress>
  <article class="page-grid" id="top" data-post>
    <header class="post-header wide">
      <ul class="post-tags" aria-label="Topics">
        <li>Design</li>
        <li>Reference</li>
      </ul>
      <h1 class="post-title">Styleguide</h1>
      <p class="post-meta">
        <span class="post-meta__author">by <a href="/about/">{SITE.author}</a></span>
        <span>All elements of this site on one page</span>
      </p>
    </header>

    <div class="prose" data-post-body>
      <p class="lead">This page shows all the style elements that define the design of this site. You are now reading an intro paragraph: it opens an article or page, is slightly larger than the running text and has a small green stroke as an accent.</p>

      <!-- ================================================================ -->
      <h2 id="colour">Colour</h2>
      <p>One warm paper colour, three shades of ink and one green accent. The green is reserved for what you can click or what lights up: links, note numbers and the note under your mouse.</p>
      <p>Dark mode follows the setting of your system. On this page you can also choose it yourself.</p>
      <div class="theme-switch" role="group" aria-label="Colour theme">
        <button type="button" data-theme-choice="light" aria-pressed="false">Light</button>
        <button type="button" data-theme-choice="dark" aria-pressed="false">Dark</button>
        <button type="button" data-theme-choice="system" aria-pressed="true">System</button>
      </div>
      <div class="bleed">
        <ul class="swatches">
          {
            swatches.map((s) => (
              <li class="swatch">
                <span class="swatch__chip" style={`--c: var(${s.token})`} />
                <span class="swatch__name">{s.name}</span>
                <span class="swatch__use">{s.use}</span>
                <code class="swatch__token">{s.token}</code>
                <span class="swatch__hex">
                  {s.light} / {s.dark}
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- ================================================================ -->
      <h2 id="typefaces">Typefaces</h2>
      <p>Two families that clearly differ from each other. The serif is for everything you read, the sans-serif for everything you use: menu, metadata, labels and tables. Both are hosted locally via Fontsource, without requests to Google.</p>

      <div class="spec" data-in-margin>
        <p class="type-sample type-sample--serif">The quick brown fox jumps over the lazy dog</p>
        <p class="spec__note"><strong>Newsreader</strong> by Production Type. Running text, headings and notes. Variable in weight (200 to 800) and optical size, so small text automatically becomes slightly sturdier.</p>
      </div>
      <div class="spec" data-in-margin>
        <p class="type-sample type-sample--sans">The quick brown fox jumps over the lazy dog</p>
        <p class="spec__note"><strong>Cabin</strong> by Impallari Type, a humanist sans-serif in the line of Johnston and Gill. Menu, metadata, labels and tables.</p>
      </div>
      <div class="spec" data-in-margin>
        <p class="type-sample type-sample--mono">The quick brown fox jumps over the lazy dog</p>
        <p class="spec__note"><strong>System font</strong> for code: SF Mono, Cascadia Mono, Menlo or Consolas, depending on your device.</p>
      </div>

      <h3>The iI1l test</h3>
      <p>Hopefully these letterforms differ enough, so that you don’t mistake a 1 for an l, or an i and an I for an l.</p>
      <ul class="glyph-test">
        <li><span class="type-sample--serif">iI1l 0O</span>Newsreader</li>
        <li><span class="type-sample--sans">iI1l 0O</span>Cabin</li>
        <li><span class="type-sample--mono">iI1l 0O</span>Mono</li>
      </ul>

      <!-- ================================================================ -->
      <h2 id="headings">Headings</h2>
      <p>Headings are set in Newsreader. The page title is the largest and the lightest; the smaller the heading, the heavier, so that every heading stays equally clear.</p>

      <div class="spec" data-in-margin>
        <p class="post-title">Title of a piece</p>
        <p class="spec__note">Page title, <code>.post-title</code>. Newsreader 400, from 2.4 to 4 rem, scales with the screen.</p>
      </div>

      <div class="spec" data-in-margin>
        <div class="spec__sample">
          <h1>Heading 1</h1>
          <p>Only use an h1 in the text on pages without a page title. In a regular piece the title is the h1 and the structure starts at h2.</p>
        </div>
        <p class="spec__note"><code>h1</code> in the text. Newsreader 450, 2.1 times the text size.</p>
      </div>

      <div class="spec" data-in-margin>
        <div class="spec__sample">
          <h2>Heading 2</h2>
          <p>An h2 opens a new chapter. There is a fair amount of space above it, so that while scrolling you see where a new part begins.</p>
        </div>
        <p class="spec__note"><code>h2</code>. Newsreader 560, 1.6 times the text size. Appears in the margin line.</p>
      </div>

      <div class="spec" data-in-margin>
        <div class="spec__sample">
          <h3>Heading 3</h3>
          <p>An h3 divides a chapter. If it is directly below an h2, the space between them becomes smaller.</p>
        </div>
        <p class="spec__note"><code>h3</code>. Newsreader 600, 1.22 times the text size. Appears indented in the margin line.</p>
      </div>

      <div class="spec" data-in-margin>
        <div class="spec__sample">
          <h4>Heading 4</h4>
          <p>An h4 is for a short subheading, for example above a list or an example. It does not appear in the margin line.</p>
        </div>
        <p class="spec__note"><code>h4</code>. Newsreader 650, the same size as the text.</p>
      </div>

      <!-- ================================================================ -->
      <h2 id="paragraphs">Paragraphs</h2>

      <div class="spec" data-in-margin>
        <p>This is a regular paragraph. The lines are ragged on the right: justifying quickly creates gaps between words on the web. Long words are hyphenated according to the language of the page, so that the right edge still stays calm.</p>
        <p class="spec__note"><strong>Running text.</strong> Newsreader 400, 18 to 20 pixels, line height 1.62. Hyphenation via <code>lang="en"</code>.</p>
      </div>

      <h3>Intro paragraph</h3>
      <p>The paragraph at the top of this page. Give a <code>p</code> the class <code>lead</code> and it becomes larger and lighter, with a stroke in the accent colour below it.</p>

      <h3>Line length</h3>
      <p>A line reads most comfortably at 45 to 75 characters; 66 is considered ideal.<sup><a href="#user-content-fn-line-length-a" id="user-content-fnref-line-length-a" data-footnote-ref aria-describedby="footnote-label">1</a></sup><sup><a href="#user-content-fn-line-length-b" id="user-content-fnref-line-length-b" data-footnote-ref aria-describedby="footnote-label">2</a></sup><sup><a href="#user-content-fn-line-length-c" id="user-content-fnref-line-length-c" data-footnote-ref aria-describedby="footnote-label">3</a></sup></p>
      <p>I take that into account in the <code>max-width</code> of the text column. It is set in <code>--measure</code> to 40 rem: about seventy characters in this typeface.</p>

      <h3>Wide</h3>
      <p>A block with the class <code>bleed</code> runs on wide screens all the way up to and including the notes column. Useful for images, tables and the odd passage that deserves more room.<sup><a href="#user-content-fn-bleed" id="user-content-fnref-bleed" data-footnote-ref aria-describedby="footnote-label">4</a></sup></p>
      <div class="bleed">
        <p>This is what a wide paragraph looks like. Use it sparingly: a line of well over a hundred characters reads noticeably heavier, and that is exactly why the regular text column is narrower. For a short, special passage it can work. For regular text it does not.</p>
      </div>

      <h3>Divider</h3>
      <p>An <code>hr</code> becomes a small group of stars: it marks a turn in the text, without a hard line.</p>
      <hr />

      <!-- ================================================================ -->
      <h2 id="text-formatting">Text formatting</h2>

      <h3>Italic</h3>
      <p>The element <code>i</code> is for words in a different voice, mood or language, such as technical terms or an expression from another language.</p>
      <p><i>The quick brown fox jumps over the lazy dog.</i></p>

      <h3>Emphasis</h3>
      <p>With <code>em</code> you place stress: something you would pronounce differently. If italics are only a stylistic choice, use <code>i</code>.</p>
      <p>You really <em>must</em> try that new twelve-year-old Aultmore!</p>

      <h3>Strong</h3>
      <p>With <code>strong</code> you indicate that something is important. For bold without that meaning there is <code>b</code>.</p>
      <p>Do <strong>not</strong> put nails in the power socket.</p>

      <h3>Links</h3>
      <p><a href="https://www.google.com" title="Search for it on Google">Butterscotch squares that do things right</a>. A link is green with a thin, light underline. Point at it and the line becomes solid.</p>

      <h3>Abbreviations</h3>
      <p>Abbreviations such as <abbr title="HyperText Markup Language">HTML</abbr> get an <code>abbr</code>, with a <code>title</code> for the full name. The dotted line shows that there is an explanation; point at the abbreviation to read it.</p>

      <h3>Titles of works</h3>
      <p>Titles of books, films and articles go in a <code>cite</code>, such as <cite>The Elements of Typographic Style</cite> by Robert Bringhurst.</p>

      <h3>Deleted and inserted</h3>
      <p>Deleted text goes in <del>del</del>, inserted text in <ins>ins</ins>.</p>

      <h3>Superscript and subscript</h3>
      <p>Superscript uses <sup>sup</sup> and subscript <sub>sub</sub>, as in m<sup>2</sup> and H<sub>2</sub>O.</p>

      <h3>Keys</h3>
      <p>The keys <kbd>⌘</kbd> and <kbd>Shift</kbd> are important.</p>
      <p>And now everything mixed together: an <abbr>abbr.</abbr> here, a <sup>sup</sup> there and a <sub>sub</sub> in between. See how <kbd>⌘</kbd>, <kbd>Shift</kbd>, <kbd>F4</kbd> and <kbd>Caps Lock</kbd> behave in the middle of a paragraph, next to <del>old</del> <ins>new</ins> text, <strong>bold</strong>, <em>italic</em> and <code>code</code>. The line spacing should stay the same everywhere, even when there is all sorts of things between the lines.</p>

      <!-- ================================================================ -->
      <h2 id="boxes">Boxes and quotes</h2>

      <h3>Aside</h3>
      <p>An <code>aside</code> is for a side path that is just too big for a note.</p>
      <aside><p>This is an aside. Calm, slightly smaller than the text, and clearly not part of the main argument.</p></aside>

      <h3>Information</h3>
      <p>With <code>class="information"</code> the box turns green and gets a small sign. For something the reader really needs to know, such as a correction or an update.</p>
      <aside class="information"><p>This piece was updated on 22 September 2026. The examples now use Astro 7.</p></aside>

      <h3>Quote</h3>
      <blockquote>
        <p>A quote is indented slightly, with a line next to it. The source goes below it, smaller and in the sans-serif.<cite><a href="https://www.google.com" title="Search for it on Google">Name of the source</a>, an explanation</cite></p>
      </blockquote>

      <!-- ================================================================ -->
      <h2 id="lists">Lists</h2>

      <h3>Numbered</h3>
      <ol>
        <li>Write a first draft</li>
        <li>
          Let it rest for a night
          <ol>
            <li>read it out loud</li>
            <li>cut what is not needed</li>
          </ol>
        </li>
        <li>Publish</li>
      </ol>

      <h3>Unnumbered</h3>
      <ul>
        <li>
          Paper
          <ul>
            <li>lined</li>
            <li>blank</li>
          </ul>
        </li>
        <li>Pencil</li>
        <li>Eraser</li>
      </ul>

      <!-- ================================================================ -->
      <h2 id="code">Code</h2>
      <p>Code in the text gets a light background, such as <code>font-optical-sizing</code>. Code blocks follow the light or dark theme and scroll sideways if a line is too long.</p>
      <Code code={jsSample} lang="js" themes={codeThemes} defaultColor={false} />
      <Code code={cssSample} lang="css" themes={codeThemes} defaultColor={false} />

      <!-- ================================================================ -->
      <h2 id="images">Images</h2>

      <h3>In the text column</h3>
      <p>An image is as wide as the text. On wide screens the caption is in the margin, just like a note, aligned with the bottom of the photo.</p>
      <figure>
        <a href={brug.src}>
          <Image src={brug} alt="Black-and-white photo of a steel arch bridge for the train over the water, with large graffiti letters on the side." widths={[640, 960, 1280]} sizes="(min-width: 40rem) 40rem, 100vw" />
        </a>
        <figcaption>This is the caption of the image. On a narrow screen it is below it.</figcaption>
      </figure>

      <h3>Wide</h3>
      <p>In a <code>bleed</code> the image runs into the margin. The caption then goes below it.</p>
      <div class="bleed">
        <figure>
          <a href={brug.src}>
            <Image src={brug} alt="The same bridge, shown wider." widths={[960, 1280, 1920]} sizes="(min-width: 70rem) 58.5rem, 100vw" />
          </a>
          <figcaption>This is the caption of a wide image.</figcaption>
        </figure>
      </div>

      <!-- ================================================================ -->
      <h2 id="tables">Tables</h2>
      <p>Tables are set in the sans-serif. A wide table sits in a <code>bleed</code> and scrolls sideways on smaller screens. On a phone every row becomes a small block, with the column name in front of it.</p>
      <div class="bleed">
        <div class="table-wrap" role="region" aria-labelledby="table-lamy" tabindex="0">
          <table>
            <caption id="table-lamy">Lamy Studio: special and regular editions</caption>
            <thead>
              <tr>
                <th scope="col">Year</th>
                {penColumns.map((c) => <th scope="col">{c}</th>)}
              </tr>
            </thead>
            <tbody>
              {
                pens.map(([year, ...cells]) => (
                  <tr>
                    <th scope="row">{year}</th>
                    {cells.map((cell, i) => (
                      <td data-label={penColumns[i]}>{cell}</td>
                    ))}
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>

      <!-- ================================================================ -->
      <h2 id="margin-line">Margin line, notes and menu</h2>

      <h3>Margin line</h3>
      <p>To the left of the text runs a line that fills up as you read, with a tick for every h2 and h3, at the height where that chapter is. Move your mouse to the left edge and the titles appear. It also works with <kbd>Tab</kbd>, and on a tablet you tap the margin line. On a phone the contents are in the menu and a green bar runs under the header.</p>

      <h3>Notes</h3>
      <p>You simply write footnotes in Markdown. From 1120 pixels wide they are in the right margin, on the same baseline as their number. Point at the number or the note and they light up together. On narrower screens the note appears in a small window when you point at the number, and all notes are at the bottom.</p>

      <h3>Header</h3>
      <p>The header is semi-transparent and blurs what is underneath it, so that the text slides underneath it, blurred. It disappears when you scroll down and comes back as soon as you scroll up.</p>

      <h3>Menu button</h3>
      <p>Three lines that turn into a cross when the menu opens. The menu slides in from the left, the items come in shortly after each other.</p>
      <div class="menu-demo">
        <button type="button" class="menu-button" aria-expanded="false" aria-label="Example of the menu button" data-menu-demo>
          <span class="menu-button__icon" aria-hidden="true"><span></span><span></span><span></span></span>
        </button>
        <span>Click to switch between closed and open.</span>
      </div>

      <!-- ================================================================ -->
      <h2 id="components">Components</h2>

      <h3>Topics</h3>
      <p>At the top of a piece, above the title. Small and calm, in the sans-serif.</p>
      <ul class="post-tags is-demo" aria-label="Example of topics">
        <li>Typography</li>
        <li>Reading</li>
        <li>Web</li>
      </ul>

      <h3>Article header</h3>
      <p>Topics, title and a line with author, date and reading time. The header of <a href="#top">this page</a> is an example of it.</p>

      <h3>Overview</h3>
      <p>On the overview page the newest post is shown large at the top. Below it follows the archive per year; the description of each post is in the margin, just like a note, and lights up when you point at the line.</p>
      {
        featured && (
          <div class="demo-archive bleed">
            <div class="featured">
              <p class="featured__title">
                <a href={postUrl(featured)}>{featured.frontmatter.title}</a>
              </p>
              {summary(featured) && <p class="featured__desc">{summary(featured)}</p>}
              <p class="entry-meta" lang="en">
                {featuredDate && <time datetime={featuredDate.toISOString()}>{formatDate(featuredDate)}</time>}
                <span>{readingTime(featured.rawContent())} min read</span>
              </p>
            </div>
            {demoEntries.length > 0 && (
              <div class="archive" lang="en">
                <p class="archive__year">{demoYear}</p>
                <ol class="archive__list">
                  {demoEntries.map((post) => (
                    <PostEntry post={post} date="day" />
                  ))}
                </ol>
              </div>
            )}
          </div>
        )
      }

      <h3>Below a piece</h3>
      <p>Links to the previous and the next piece, below a thin line.</p>
      {
        demoEntries.length > 1 && (
          <div class="post-nav is-demo" lang="en">
            <a class="post-nav__prev" href={postUrl(demoEntries[1])}>
              <span class="post-nav__label">Previous</span>
              <span class="post-nav__title">{demoEntries[1].frontmatter.title}</span>
            </a>
            <a class="post-nav__next" href={postUrl(demoEntries[0])}>
              <span class="post-nav__label">Next</span>
              <span class="post-nav__title">{demoEntries[0].frontmatter.title}</span>
            </a>
          </div>
        )
      }

      <!-- Footnotes, in the same form as Markdown makes them. -->
      <section data-footnotes class="footnotes">
        <h2 class="sr-only" id="footnote-label">Footnotes</h2>
        <ol>
          <li id="user-content-fn-line-length-a">
            <p><a href="http://baymard.com/blog/line-length-readability">Readability: the Optimal Line Length</a>, Baymard Institute. <a href="#user-content-fnref-line-length-a" data-footnote-backref aria-label="Back to reference 1" class="data-footnote-backref">↩</a></p>
          </li>
          <li id="user-content-fn-line-length-b">
            <p><a href="http://webtypography.net/2.1.2">The Elements of Typographic Style Applied to the Web</a>, after Robert Bringhurst. <a href="#user-content-fnref-line-length-b" data-footnote-backref aria-label="Back to reference 2" class="data-footnote-backref">↩</a></p>
          </li>
          <li id="user-content-fn-line-length-c">
            <p><a href="https://accessibility.digital.gov/visual-design/typography/">Accessibility for Teams</a>, U.S. General Services Administration. <a href="#user-content-fnref-line-length-c" data-footnote-backref aria-label="Back to reference 3" class="data-footnote-backref">↩</a></p>
          </li>
          <li id="user-content-fn-bleed">
            <p>A note that would fall next to a wide block automatically moves down to below that block. <a href="#user-content-fnref-bleed" data-footnote-backref aria-label="Back to reference 4" class="data-footnote-backref">↩</a></p>
          </li>
        </ol>
      </section>
    </div>

    <div class="sidenotes" data-sidenotes></div>
  </article>

  <TocRail items={toc} title="Styleguide" />

  <script>
    import { initSidenotes } from '../scripts/sidenotes';
    document.querySelectorAll<HTMLElement>('[data-post]').forEach(initSidenotes);

    // Light / Dark / System (only for this page, not remembered).
    const root = document.documentElement;
    const choices = document.querySelectorAll<HTMLButtonElement>('[data-theme-choice]');
    choices.forEach((button) => {
      button.addEventListener('click', () => {
        const choice = button.dataset.themeChoice;
        if (choice === 'system') delete root.dataset.theme;
        else root.dataset.theme = choice;
        choices.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
      });
    });

    // Example of the menu button.
    document.querySelectorAll<HTMLButtonElement>('[data-menu-demo]').forEach((button) => {
      button.addEventListener('click', () => {
        const open = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', String(!open));
      });
    });
  </script>
</BaseLayout>
