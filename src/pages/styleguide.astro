---
/**
 * Styleguide: alle stijlelementen van de site op één pagina.
 *
 * Gebaseerd op de oorspronkelijke styleguide, aangevuld met de onderdelen
 * van dit sjabloon. De toelichting bij elk voorbeeld staat in de marge
 * (.spec__note), net als een noot.
 *
 * De voorbeelden van het overzicht en de navigatie gebruiken echte posts en
 * dezelfde onderdelen als de rest van de site (PostEntry, .post-nav).
 *
 * Let op: houd een alinea op één regel in deze template. Astro kan
 * witruimte met een regeleinde tussen tekst en een element weghalen.
 */
import { Image } from 'astro:assets';
import { Code } from 'astro:components';
import BaseLayout from '../layouts/BaseLayout.astro';
import TocRail from '../components/TocRail.astro';
import PostEntry from '../components/PostEntry.astro';
import { SITE } from '../site.config';
import { getPosts, formatDate, parseDate, readingTime, postUrl, summary } from '../lib/posts';
import brug from '../assets/brug.jpg';
import '../styles/styleguide.css';

const toc = [
  { id: 'kleur', text: 'Kleur', depth: 2 },
  { id: 'letters', text: 'Letters', depth: 2 },
  { id: 'koppen', text: 'Koppen', depth: 2 },
  { id: 'alineas', text: 'Alinea’s', depth: 2 },
  { id: 'tekstopmaak', text: 'Tekstopmaak', depth: 2 },
  { id: 'kaders', text: 'Kaders en citaten', depth: 2 },
  { id: 'lijsten', text: 'Lijsten', depth: 2 },
  { id: 'code', text: 'Code', depth: 2 },
  { id: 'beeld', text: 'Beeld', depth: 2 },
  { id: 'tabellen', text: 'Tabellen', depth: 2 },
  { id: 'kantlijn', text: 'Kantlijn, noten en menu', depth: 2 },
  { id: 'onderdelen', text: 'Onderdelen', depth: 2 },
];

const swatches = [
  { name: 'Papier', token: '--paper', light: '#f7f5f1', dark: '#1c1d1b', use: 'Achtergrond' },
  { name: 'Papier, verhoogd', token: '--paper-raised', light: '#fdfcfa', dark: '#232421', use: 'Menu, toetsen, vensters' },
  { name: 'Inkt', token: '--ink', light: '#1d1c1a', dark: '#e9e6e0', use: 'Tekst en koppen' },
  { name: 'Inkt 2', token: '--ink-2', light: '#4a4741', dark: '#bfbab1', use: 'Intro, citaten, kaders' },
  { name: 'Inkt 3', token: '--ink-3', light: '#736e65', dark: '#969186', use: 'Metadata, noten, bijschriften' },
  { name: 'Lijn', token: '--rule', light: '#e3dfd6', dark: '#33342f', use: 'Scheidingslijnen' },
  { name: 'Lijn, sterk', token: '--rule-strong', light: '#cbc5b9', dark: '#4a4b45', use: 'Kantlijn, tabelkop' },
  { name: 'Accent', token: '--accent', light: '#2f6f4f', dark: '#8bc6a1', use: 'Links, notennummers' },
  { name: 'Accent, licht', token: '--accent-tint', light: '#e1ebe3', dark: '#26352b', use: 'Oplichten, informatiekader' },
  { name: 'Code', token: '--code-bg', light: '#eeebe4', dark: '#272824', use: 'Achtergrond van code' },
];

const pens = [
  ['2025', 'Studio Arctic Silver', 'Mat zilver, metallic', 'Staal', 'Rubber', 'Satijn metallic', 'Speciale editie'],
  ['2024', 'Studio Racing Green', 'Diep Brits groen', 'Goud (14k)', 'Staal', 'Hoogglans metallic', 'Speciale editie'],
  ['2023', 'Studio Lilac', 'Zacht lavendel, metallic', 'Staal', 'Rubber', 'Satijn geanodiseerd', 'Speciale editie'],
  ['2022', 'Studio Black Forest', 'Donkergroen, bijna zwart', 'Goud (14k)', 'Staal', 'Hoogglans lak', 'Vaste kleur (eerst speciale editie)'],
  ['2021', 'Studio Glacier', 'Koel ijsblauw', 'Staal', 'Rubber', 'Satijn geanodiseerd', 'Speciale editie'],
  ['2020', 'Studio Rose', 'Warm roségoud', 'Staal', 'Staal', 'Mat metallic', 'Speciale editie'],
  ['2019', 'Studio Aquamarine', 'Diep turquoise', 'Staal', 'Staal', 'Geanodiseerd', 'Speciale editie'],
  ['2018', 'Studio Olive', 'Mat olijfgroen', 'Staal', 'Rubber', 'Matte lak', 'Speciale editie'],
  ['2017', 'Studio Imperial Blue', 'Diep metallic blauw', 'Staal', 'Rubber', 'Hoogglans lak', 'Later vast in het assortiment'],
  ['2016', 'Studio LX All Black', 'Mat zwart', 'Staal (zwart gecoat)', 'Rubber', 'Matte lak', 'Speciale monochrome editie'],
];
const penColumns = ['Naam', 'Kleur', 'Penpunt', 'Grip', 'Afwerking', 'Opmerking'];

const jsSample = `function showError(error) {
  if(error.code==0) {
    alert('An unknown error occurred.');
  } else if(error.code==1) {
    alert('No permission to locate your position.');
  } else if(error.code==2) {
    alert('The location could not be retrieved.');
  } else {
    alert('There was a timeout.');
  }
}`;

const cssSample = `.ninja {
    visibility: hidden;
    animation-duration: 0.000001s;
}`;

const codeThemes = { light: 'github-light', dark: 'github-dark' } as const;

// Echte posts voor de voorbeelden van het overzicht en de navigatie.
const posts = await getPosts();
const [featured, ...rest] = posts;
const featuredDate = featured && parseDate(featured.frontmatter.date);
const demoEntries = rest.slice(0, 2);
const demoYear = demoEntries[0] && parseDate(demoEntries[0].frontmatter.date)?.getFullYear();
---

<BaseLayout title="Styleguide" description={`Alle stijlelementen van ${SITE.title} op één pagina.`} toc={toc} progress lang="nl">
  <article class="page-grid" id="top" data-post>
    <header class="post-header wide">
      <ul class="post-tags" aria-label="Onderwerpen">
        <li>Ontwerp</li>
        <li>Referentie</li>
      </ul>
      <h1 class="post-title">Styleguide</h1>
      <p class="post-meta">
        <span class="post-meta__author">door <a href="/about/">{SITE.author}</a></span>
        <span>Alle elementen van deze site op één pagina</span>
      </p>
    </header>

    <div class="prose" data-post-body>
      <p class="lead">Deze pagina laat alle stijlelementen zien die het ontwerp van deze site bepalen. Je leest nu een intro-alinea: die opent een artikel of pagina, is iets groter dan de lopende tekst en heeft een klein groen streepje als accent.</p>

      <!-- ================================================================ -->
      <h2 id="kleur">Kleur</h2>
      <p>Eén warme papierkleur, drie tinten inkt en één groen accent. Het groen is gereserveerd voor wat je kunt aanklikken of wat oplicht: links, notennummers en de noot die bij je muis hoort.</p>
      <p>De donkere modus volgt de instelling van je systeem. Op deze pagina kun je hem ook zelf kiezen.</p>
      <div class="theme-switch" role="group" aria-label="Kleurthema">
        <button type="button" data-theme-choice="light" aria-pressed="false">Licht</button>
        <button type="button" data-theme-choice="dark" aria-pressed="false">Donker</button>
        <button type="button" data-theme-choice="system" aria-pressed="true">Systeem</button>
      </div>
      <div class="bleed">
        <ul class="swatches">
          {
            swatches.map((s) => (
              <li class="swatch">
                <span class="swatch__chip" style={`--c: var(${s.token})`} />
                <span class="swatch__name">{s.name}</span>
                <span class="swatch__use">{s.use}</span>
                <code class="swatch__token">{s.token}</code>
                <span class="swatch__hex">
                  {s.light} / {s.dark}
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- ================================================================ -->
      <h2 id="letters">Letters</h2>
      <p>Twee families die duidelijk van elkaar verschillen. De schreefletter is voor alles wat je leest, de schreefloze voor alles wat je gebruikt: menu, metadata, labels en tabellen. Beide worden lokaal gehost via Fontsource, zonder verzoeken naar Google.</p>

      <div class="spec" data-in-margin>
        <p class="type-sample type-sample--serif">Pa’s wijze lynx bezag vroom het fikse aquaduct</p>
        <p class="spec__note"><strong>Newsreader</strong> van Production Type. Lopende tekst, koppen en noten. Variabel in gewicht (200 tot 800) en optische grootte, dus kleine tekst wordt vanzelf iets steviger.</p>
      </div>
      <div class="spec" data-in-margin>
        <p class="type-sample type-sample--sans">Pa’s wijze lynx bezag vroom het fikse aquaduct</p>
        <p class="spec__note"><strong>Cabin</strong> van Impallari Type, een humanistische schreefloze in de lijn van Johnston en Gill. Menu, metadata, labels en tabellen.</p>
      </div>
      <div class="spec" data-in-margin>
        <p class="type-sample type-sample--mono">Pa’s wijze lynx bezag vroom</p>
        <p class="spec__note"><strong>Systeemletter</strong> voor code: SF Mono, Cascadia Mono, Menlo of Consolas, afhankelijk van je apparaat.</p>
      </div>

      <h3>De iI1l-test</h3>
      <p>Hopelijk verschillen deze lettervormen genoeg, zodat je een 1 niet voor een l aanziet, of een i en een I voor een l.</p>
      <ul class="glyph-test">
        <li><span class="type-sample--serif">iI1l 0O</span>Newsreader</li>
        <li><span class="type-sample--sans">iI1l 0O</span>Cabin</li>
        <li><span class="type-sample--mono">iI1l 0O</span>Mono</li>
      </ul>

      <!-- ================================================================ -->
      <h2 id="koppen">Koppen</h2>
      <p>Koppen staan in Newsreader. De paginatitel is het grootst en het lichtst; hoe kleiner de kop, hoe zwaarder, zodat elke kop even duidelijk blijft.</p>

      <div class="spec" data-in-margin>
        <p class="post-title">Titel van een stuk</p>
        <p class="spec__note">Paginatitel, <code>.post-title</code>. Newsreader 400, van 2,4 tot 4 rem, schaalt mee met het scherm.</p>
      </div>

      <div class="spec" data-in-margin>
        <div class="spec__sample">
          <h1>Kop 1</h1>
          <p>Gebruik een h1 in de tekst alleen op pagina’s zonder paginatitel. In een gewoon stuk is de titel de h1 en begint de indeling bij h2.</p>
        </div>
        <p class="spec__note"><code>h1</code> in de tekst. Newsreader 450, 2,1 keer de tekstgrootte.</p>
      </div>

      <div class="spec" data-in-margin>
        <div class="spec__sample">
          <h2>Kop 2</h2>
          <p>Een h2 opent een nieuw hoofdstuk. Er staat flink wat ruimte boven, zodat je tijdens het scrollen ziet waar een nieuw deel begint.</p>
        </div>
        <p class="spec__note"><code>h2</code>. Newsreader 560, 1,6 keer de tekstgrootte. Verschijnt in de kantlijn.</p>
      </div>

      <div class="spec" data-in-margin>
        <div class="spec__sample">
          <h3>Kop 3</h3>
          <p>Een h3 deelt een hoofdstuk op. Staat hij direct onder een h2, dan wordt de ruimte ertussen kleiner.</p>
        </div>
        <p class="spec__note"><code>h3</code>. Newsreader 600, 1,22 keer de tekstgrootte. Verschijnt ingesprongen in de kantlijn.</p>
      </div>

      <div class="spec" data-in-margin>
        <div class="spec__sample">
          <h4>Kop 4</h4>
          <p>Een h4 is voor een kort tussenkopje, bijvoorbeeld boven een lijst of een voorbeeld. Hij komt niet in de kantlijn.</p>
        </div>
        <p class="spec__note"><code>h4</code>. Newsreader 650, even groot als de tekst.</p>
      </div>

      <!-- ================================================================ -->
      <h2 id="alineas">Alinea’s</h2>

      <div class="spec" data-in-margin>
        <p>Dit is een gewone alinea. De regels lopen rafelig uit aan de rechterkant: uitvullen levert op het web al snel gaten tussen woorden op. Lange woorden worden afgebroken volgens de taal van de pagina, zodat de rechterkant toch rustig blijft.</p>
        <p class="spec__note"><strong>Lopende tekst.</strong> Newsreader 400, 18 tot 20 pixels, regelafstand 1,62. Afbreken via <code>lang="nl"</code>.</p>
      </div>

      <h3>Intro-alinea</h3>
      <p>De alinea bovenaan deze pagina. Geef een <code>p</code> de klasse <code>lead</code> en hij wordt groter en lichter, met een streepje in de accentkleur eronder.</p>

      <h3>Regellengte</h3>
      <p>Een regel leest het prettigst bij 45 tot 75 tekens; 66 geldt als ideaal.<sup><a href="#user-content-fn-regellengte-a" id="user-content-fnref-regellengte-a" data-footnote-ref aria-describedby="footnote-label">1</a></sup><sup><a href="#user-content-fn-regellengte-b" id="user-content-fnref-regellengte-b" data-footnote-ref aria-describedby="footnote-label">2</a></sup><sup><a href="#user-content-fn-regellengte-c" id="user-content-fnref-regellengte-c" data-footnote-ref aria-describedby="footnote-label">3</a></sup></p>
      <p>Daar houd ik rekening mee bij de <code>max-width</code> van de tekstkolom. Die staat in <code>--measure</code> op 40 rem: zo’n zeventig tekens bij deze letter.</p>

      <h3>Breed</h3>
      <p>Een blok met de klasse <code>bleed</code> loopt op brede schermen door tot en met de notenkolom. Handig voor afbeeldingen, tabellen en een enkele passage die meer ruimte verdient.<sup><a href="#user-content-fn-bleed" id="user-content-fnref-bleed" data-footnote-ref aria-describedby="footnote-label">4</a></sup></p>
      <div class="bleed">
        <p>Zo ziet een brede alinea eruit. Gebruik dit spaarzaam: een regel van ruim honderd tekens leest merkbaar zwaarder, en dat is precies waarom de gewone tekstkolom smaller is. Voor een korte, bijzondere passage kan het werken. Voor gewone tekst niet.</p>
      </div>

      <h3>Scheidingslijn</h3>
      <p>Een <code>hr</code> wordt een klein sterrengroepje: het markeert een wending in de tekst, zonder harde lijn.</p>
      <hr />

      <!-- ================================================================ -->
      <h2 id="tekstopmaak">Tekstopmaak</h2>

      <h3>Cursief</h3>
      <p>Het element <code>i</code> is voor woorden in een andere stem, stemming of taal, zoals vaktermen of een uitdrukking uit een andere taal.</p>
      <p><i>Pa’s wijze lynx bezag vroom het fikse aquaduct.</i></p>

      <h3>Nadruk</h3>
      <p>Met <code>em</code> leg je klemtoon: iets wat je anders uitspreekt. Is cursief alleen een stijlkeuze, gebruik dan <code>i</code>.</p>
      <p>Je <em>moet</em> die nieuwe twaalfjarige Aultmore echt proberen!</p>

      <h3>Sterk</h3>
      <p>Met <code>strong</code> geef je aan dat iets belangrijk is. Voor vet zonder die betekenis is er <code>b</code>.</p>
      <p>Steek <strong>geen</strong> spijkers in het stopcontact.</p>

      <h3>Links</h3>
      <p><a href="https://www.google.com" title="Zoek het op Google">Boterkaramelblokjes die het goed aanpakken</a>. Een link is groen met een dunne, lichte onderstreping. Wijs hem aan en de streep wordt vol.</p>

      <h3>Afkortingen</h3>
      <p>Afkortingen zoals <abbr title="HyperText Markup Language">HTML</abbr> krijgen een <code>abbr</code>, met een <code>title</code> voor de volledige naam. De gestippelde lijn laat zien dat er uitleg is; wijs de afkorting aan om die te lezen.</p>

      <h3>Werktitels</h3>
      <p>Titels van boeken, films en artikelen staan in een <code>cite</code>, zoals <cite>The Elements of Typographic Style</cite> van Robert Bringhurst.</p>

      <h3>Verwijderd en toegevoegd</h3>
      <p>Verwijderde tekst staat in <del>del</del>, toegevoegde tekst in <ins>ins</ins>.</p>

      <h3>Superschrift en subschrift</h3>
      <p>Superschrift gebruikt <sup>sup</sup> en subschrift <sub>sub</sub>, zoals in m<sup>2</sup> en H<sub>2</sub>O.</p>

      <h3>Toetsen</h3>
      <p>De toetsen <kbd>⌘</kbd> en <kbd>Shift</kbd> zijn belangrijk.</p>
      <p>En nu alles door elkaar: een <abbr>afk.</abbr> hier, een <sup>sup</sup> daar en een <sub>sub</sub> ertussen. Kijk hoe <kbd>⌘</kbd>, <kbd>Shift</kbd>, <kbd>F4</kbd> en <kbd>Caps Lock</kbd> zich gedragen midden in een alinea, naast <del>oude</del> <ins>nieuwe</ins> tekst, <strong>vet</strong>, <em>cursief</em> en <code>code</code>. De regelafstand hoort overal gelijk te blijven, ook als er van alles tussen de regels staat.</p>

      <!-- ================================================================ -->
      <h2 id="kaders">Kaders en citaten</h2>

      <h3>Terzijde</h3>
      <p>Een <code>aside</code> is voor een zijpad dat net te groot is voor een noot.</p>
      <aside><p>Dit is een terzijde. Rustig, iets kleiner dan de tekst, en duidelijk geen onderdeel van het hoofdbetoog.</p></aside>

      <h3>Informatie</h3>
      <p>Met <code>class="information"</code> wordt het kader groen en krijgt het een klein teken. Voor iets wat de lezer echt moet weten, zoals een correctie of een update.</p>
      <aside class="information"><p>Dit stuk is bijgewerkt op 22 september 2026. De voorbeelden gebruiken nu Astro 7.</p></aside>

      <h3>Citaat</h3>
      <blockquote>
        <p>Een citaat springt iets in, met een lijn ernaast. De bron komt eronder, kleiner en in de schreefloze.<cite><a href="https://www.google.com" title="Zoek het op Google">Naam van de bron</a>, een toelichting</cite></p>
      </blockquote>

      <!-- ================================================================ -->
      <h2 id="lijsten">Lijsten</h2>

      <h3>Genummerd</h3>
      <ol>
        <li>Schrijf een eerste versie</li>
        <li>
          Laat hem een nacht liggen
          <ol>
            <li>lees hem hardop</li>
            <li>schrap wat niet nodig is</li>
          </ol>
        </li>
        <li>Publiceer</li>
      </ol>

      <h3>Ongenummerd</h3>
      <ul>
        <li>
          Papier
          <ul>
            <li>gelinieerd</li>
            <li>blanco</li>
          </ul>
        </li>
        <li>Potlood</li>
        <li>Gum</li>
      </ul>

      <!-- ================================================================ -->
      <h2 id="code">Code</h2>
      <p>Code in de tekst krijgt een lichte achtergrond, zoals <code>font-optical-sizing</code>. Codeblokken volgen het lichte of donkere thema en scrollen zijwaarts als een regel te lang is.</p>
      <Code code={jsSample} lang="js" themes={codeThemes} defaultColor={false} />
      <Code code={cssSample} lang="css" themes={codeThemes} defaultColor={false} />

      <!-- ================================================================ -->
      <h2 id="beeld">Beeld</h2>

      <h3>In de tekstkolom</h3>
      <p>Een afbeelding is zo breed als de tekst. Op brede schermen staat het bijschrift in de marge, net als een noot, uitgelijnd met de onderkant van de foto.</p>
      <figure>
        <a href={brug.src}>
          <Image src={brug} alt="Zwart-witfoto van een stalen boogbrug voor de trein over het water, met grote graffitiletters op de zijkant." widths={[640, 960, 1280]} sizes="(min-width: 40rem) 40rem, 100vw" />
        </a>
        <figcaption>Dit is het bijschrift bij de afbeelding. Op een smal scherm staat het eronder.</figcaption>
      </figure>

      <h3>Breed</h3>
      <p>In een <code>bleed</code> loopt de afbeelding door tot in de marge. Het bijschrift staat er dan onder.</p>
      <div class="bleed">
        <figure>
          <a href={brug.src}>
            <Image src={brug} alt="Dezelfde brug, breder weergegeven." widths={[960, 1280, 1920]} sizes="(min-width: 70rem) 58.5rem, 100vw" />
          </a>
          <figcaption>Dit is het bijschrift bij een brede afbeelding.</figcaption>
        </figure>
      </div>

      <!-- ================================================================ -->
      <h2 id="tabellen">Tabellen</h2>
      <p>Tabellen staan in de schreefloze. Een brede tabel staat in een <code>bleed</code> en scrolt op kleinere schermen zijwaarts. Op een telefoon wordt elke rij een blokje, met de kolomnaam ervoor.</p>
      <div class="bleed">
        <div class="table-wrap" role="region" aria-labelledby="tabel-lamy" tabindex="0">
          <table>
            <caption id="tabel-lamy">Lamy Studio: speciale en vaste edities</caption>
            <thead>
              <tr>
                <th scope="col">Jaar</th>
                {penColumns.map((c) => <th scope="col">{c}</th>)}
              </tr>
            </thead>
            <tbody>
              {
                pens.map(([year, ...cells]) => (
                  <tr>
                    <th scope="row">{year}</th>
                    {cells.map((cell, i) => (
                      <td data-label={penColumns[i]}>{cell}</td>
                    ))}
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>

      <!-- ================================================================ -->
      <h2 id="kantlijn">Kantlijn, noten en menu</h2>

      <h3>Kantlijn</h3>
      <p>Links van de tekst loopt een lijn die volloopt terwijl je leest, met een streepje voor elke h2 en h3, op de hoogte waar dat hoofdstuk staat. Beweeg je muis naar de linkerrand en de titels verschijnen. Met <kbd>Tab</kbd> werkt het ook, en op een tablet tik je op de kantlijn. Op een telefoon staat de inhoud in het menu en loopt er een groene balk onder de header.</p>

      <h3>Noten</h3>
      <p>Voetnoten schrijf je gewoon in Markdown. Vanaf 1120 pixels breed staan ze in de rechtermarge, op dezelfde basislijn als hun nummertje. Wijs het nummer of de noot aan en ze lichten samen op. Op smallere schermen verschijnt de noot in een klein venster als je het nummer aanwijst, en staan alle noten onderaan.</p>

      <h3>Header</h3>
      <p>De header is half doorzichtig en vervaagt wat eronder zit, zodat de tekst er wazig onderdoor schuift. Hij verdwijnt als je naar beneden scrolt en komt terug zodra je omhoog scrolt.</p>

      <h3>Menuknop</h3>
      <p>Drie lijnen die naar een kruis draaien als het menu opent. Het menu schuift van links in, de items komen kort na elkaar binnen.</p>
      <div class="menu-demo">
        <button type="button" class="menu-button" aria-expanded="false" aria-label="Voorbeeld van de menuknop" data-menu-demo>
          <span class="menu-button__icon" aria-hidden="true"><span></span><span></span><span></span></span>
        </button>
        <span>Klik om te wisselen tussen dicht en open.</span>
      </div>

      <!-- ================================================================ -->
      <h2 id="onderdelen">Onderdelen</h2>

      <h3>Onderwerpen</h3>
      <p>Bovenaan een stuk, boven de titel. Klein en rustig, in de schreefloze.</p>
      <ul class="post-tags is-demo" aria-label="Voorbeeld van onderwerpen">
        <li>Typografie</li>
        <li>Lezen</li>
        <li>Web</li>
      </ul>

      <h3>Artikelkop</h3>
      <p>Onderwerpen, titel en een regel met auteur, datum en leestijd. De kop van <a href="#top">deze pagina</a> is er een voorbeeld van.</p>

      <h3>Overzicht</h3>
      <p>Op de overzichtspagina staat de nieuwste post groot bovenaan. Daaronder volgt het archief per jaar; de omschrijving van elke post staat in de marge, net als een noot, en licht op als je de regel aanwijst.</p>
      {
        featured && (
          <div class="demo-archive bleed">
            <div class="featured">
              <p class="featured__title">
                <a href={postUrl(featured)}>{featured.frontmatter.title}</a>
              </p>
              {summary(featured) && <p class="featured__desc">{summary(featured)}</p>}
              <p class="entry-meta" lang="en">
                {featuredDate && <time datetime={featuredDate.toISOString()}>{formatDate(featuredDate)}</time>}
                <span>{readingTime(featured.rawContent())} min read</span>
              </p>
            </div>
            {demoEntries.length > 0 && (
              <div class="archive" lang="en">
                <p class="archive__year">{demoYear}</p>
                <ol class="archive__list">
                  {demoEntries.map((post) => (
                    <PostEntry post={post} date="day" />
                  ))}
                </ol>
              </div>
            )}
          </div>
        )
      }

      <h3>Onder een stuk</h3>
      <p>Links naar het vorige en het volgende stuk, onder een dunne lijn.</p>
      {
        demoEntries.length > 1 && (
          <div class="post-nav is-demo" lang="en">
            <a class="post-nav__prev" href={postUrl(demoEntries[1])}>
              <span class="post-nav__label">Previous</span>
              <span class="post-nav__title">{demoEntries[1].frontmatter.title}</span>
            </a>
            <a class="post-nav__next" href={postUrl(demoEntries[0])}>
              <span class="post-nav__label">Next</span>
              <span class="post-nav__title">{demoEntries[0].frontmatter.title}</span>
            </a>
          </div>
        )
      }

      <!-- Voetnoten, in dezelfde vorm als Markdown ze maakt. -->
      <section data-footnotes class="footnotes">
        <h2 class="sr-only" id="footnote-label">Voetnoten</h2>
        <ol>
          <li id="user-content-fn-regellengte-a">
            <p><a href="http://baymard.com/blog/line-length-readability">Readability: the Optimal Line Length</a>, Baymard Institute. <a href="#user-content-fnref-regellengte-a" data-footnote-backref aria-label="Terug naar verwijzing 1" class="data-footnote-backref">↩</a></p>
          </li>
          <li id="user-content-fn-regellengte-b">
            <p><a href="http://webtypography.net/2.1.2">The Elements of Typographic Style Applied to the Web</a>, naar Robert Bringhurst. <a href="#user-content-fnref-regellengte-b" data-footnote-backref aria-label="Terug naar verwijzing 2" class="data-footnote-backref">↩</a></p>
          </li>
          <li id="user-content-fn-regellengte-c">
            <p><a href="https://accessibility.digital.gov/visual-design/typography/">Accessibility for Teams</a>, U.S. General Services Administration. <a href="#user-content-fnref-regellengte-c" data-footnote-backref aria-label="Terug naar verwijzing 3" class="data-footnote-backref">↩</a></p>
          </li>
          <li id="user-content-fn-bleed">
            <p>Een noot die naast een breed blok zou vallen, schuift vanzelf door tot onder dat blok. <a href="#user-content-fnref-bleed" data-footnote-backref aria-label="Terug naar verwijzing 4" class="data-footnote-backref">↩</a></p>
          </li>
        </ol>
      </section>
    </div>

    <div class="sidenotes" data-sidenotes></div>
  </article>

  <TocRail items={toc} title="Styleguide" label="Inhoud" />

  <script>
    import { initSidenotes } from '../scripts/sidenotes';
    document.querySelectorAll<HTMLElement>('[data-post]').forEach(initSidenotes);
  
    // Licht / Donker / Systeem (alleen voor deze pagina, niet onthouden).
    const root = document.documentElement;
    const choices = document.querySelectorAll<HTMLButtonElement>('[data-theme-choice]');
    choices.forEach((button) => {
      button.addEventListener('click', () => {
        const choice = button.dataset.themeChoice;
        if (choice === 'system') delete root.dataset.theme;
        else root.dataset.theme = choice;
        choices.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
      });
    });
  
    // Voorbeeld van de menuknop.
    document.querySelectorAll<HTMLButtonElement>('[data-menu-demo]').forEach((button) => {
      button.addEventListener('click', () => {
        const open = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', String(!open));
      });
    });
  </script>
</BaseLayout>
